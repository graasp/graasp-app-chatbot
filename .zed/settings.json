      "language_servers": ["typescript-language-server", "oxc", "..."]
    },
    "JavaScript": {
      "language_servers": ["typescript-language-server", "oxc", "..."]
    },
    "JSX": {
      "language_servers": ["typescript-language-server", "oxc", "..."]
    }
  }
}
